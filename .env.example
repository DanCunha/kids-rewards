# Copie este arquivo para `.env` e preencha com os dados do seu provedor de email.
# Exemplos:
#   Gmail:     Host=smtp.gmail.com       Port=587  (use uma "Senha de app" do Google)
#   Outlook:   Host=smtp.office365.com   Port=587
#   SendGrid:  Host=smtp.sendgrid.net    Port=587  Username=apikey

SmtpSettings__Host=
SmtpSettings__Port=587
SmtpSettings__Username=
SmtpSettings__Password=
SmtpSettings__FromEmail=
SmtpSettings__FromName=KidsRewards
SmtpSettings__EnableSsl=true
